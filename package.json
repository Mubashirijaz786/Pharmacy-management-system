{
  "name": "pharmacy",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Pharmacy Management ERP & POS System",
  "author": "PharmaCare ERP",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node init && vite",
    "build": "node init && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backend": "run-backend.bat",
    "fullstack": "concurrently -k \"npm run backend\" \"npm run dev\"",
    "electron:dev": "electron electron/main.cjs",
    "app:dev": "concurrently -k \"npm run backend\" \"npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "dist:win": "vite build && npx electron-builder --win"
  },
  "build": {
    "appId": "com.pharmacare.erp",
    "productName": "PharmaCare ERP",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "build_installer"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.1",
    "wait-on": "^8.0.2"
  }
}
